{
  "name": "payload-components",
  "version": "1.2.1",
  "description": "MIT registry and CLI for installing wired Payload CMS blocks into Payload v3 + Next.js projects.",
  "keywords": [
    "payload",
    "payload-cms",
    "payloadcms",
    "nextjs",
    "react",
    "shadcn",
    "tailwindcss",
    "typescript",
    "cms",
    "component-library",
    "open-source",
    "open-source-projects"
  ],
  "license": "MIT",
  "homepage": "https://www.payload-components.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ducksss/payload-components.git"
  },
  "bugs": {
    "url": "https://github.com/Ducksss/payload-components/issues"
  },
  "type": "module",
  "bin": {
    "payload-components": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "payload-components/registry.json",
    "payload-components/support-matrix.json",
    "payload-components/manifests/",
    "payload-components/schema/",
    "payload-components/source/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "build:e2e": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/payload-components/build-e2e.ts",
    "build:cli": "cross-env NODE_OPTIONS=--no-deprecation tsup",
    "blog:visuals": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/blog/render-visuals.ts",
    "blog:visuals:captures": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/blog/capture-figures.ts",
    "blog:visuals:covers": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/blog/render-covers.ts",
    "blog:visuals:figures": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/blog/generate-figures.ts",
    "blog:visuals:review": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/blog/render-contact-sheets.ts",
    "dev": "cross-env NODE_OPTIONS='--no-deprecation --max-old-space-size=12288' next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload-components": "node ./bin/payload-components.mjs",
    "prebuild": "pnpm source:build && pnpm registry:build",
    "prepack": "pnpm build:cli",
    "registry:build": "cross-env NODE_OPTIONS=--no-deprecation pnpm exec shadcn build payload-components/registry.json --output public/r --cwd .",
    "registry:check": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/payload-components/check-public-registry.ts",
    "registry:validate": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/payload-components/validate-registry.ts",
    "showcase:capture": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/showcase/capture.ts",
    "source:build": "cross-env NODE_OPTIONS=--no-deprecation fumadocs-mdx",
    "templates:capture": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/templates/capture.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "tsx tools/run-e2e.ts",
    "test:fresh": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/payload-components/smoke/fresh-payload-repo.ts",
    "test:install": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts tests/int/payload-components.int.spec.ts tests/int/payload-components-registry.int.spec.ts tests/int/payload-components-add-command.int.spec.ts tests/int/payload-components-doctor-command.int.spec.ts",
    "test:pack": "cross-env NODE_OPTIONS=--no-deprecation RUN_PACK_TEST=1 vitest run --config ./vitest.config.mts tests/int/payload-components-pack.int.spec.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:registry": "pnpm registry:check && pnpm registry:validate",
    "test:release": "pnpm lint && pnpm source:build && pnpm exec tsc --noEmit && pnpm test:registry && pnpm run test:int && pnpm build:e2e && cross-env PLAYWRIGHT_SERVER_MODE=production pnpm run test:e2e"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/semver": "^7.7.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.10",
    "fumadocs-core": "16.12.0",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.12.0",
    "geist": "^1.7.2",
    "lucide-react": "1.25.0",
    "motion": "12.42.2",
    "next": "16.2.11",
    "postcss": "^8.5.14",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "4.7.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "esbuild": "0.28.1",
      "fast-uri": "3.1.4",
      "postcss": "8.5.14",
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=5.0.0 <5.0.7": "5.0.7",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "vite@>=7.0.0 <=7.3.4": "7.3.5",
      "js-yaml@<4.3.0": "4.3.0",
      "sharp@<0.35.3": "0.35.3",
      "@babel/core@<=7.29.0": "7.29.7"
    }
  }
}
