{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.payload-components.xyz/schema/poc-manifest.schema.json",
  "title": "Payload Components Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "title",
    "description",
    "registryItemName",
    "dependencies",
    "peerDependencies",
    "supportedTargets",
    "supports",
    "files",
    "payloadFragments",
    "postInstall",
    "preview",
    "sampleContent",
    "recovery"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "registryItemName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "peerDependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "supportedTargets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "supports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadMajors",
        "nextMajors"
      ],
      "properties": {
        "payloadMajors": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        },
        "nextMajors": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "payloadFragments": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "importName",
              "importPath",
              "blockSlug"
            ],
            "properties": {
              "kind": {
                "const": "renderBlocks"
              },
              "importName": {
                "type": "string",
                "minLength": 1
              },
              "importPath": {
                "type": "string",
                "minLength": 1
              },
              "blockSlug": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "importName",
              "importPath",
              "blockName"
            ],
            "properties": {
              "kind": {
                "const": "pagesLayout"
              },
              "importName": {
                "type": "string",
                "minLength": 1
              },
              "importPath": {
                "type": "string",
                "minLength": 1
              },
              "blockName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "postInstall": {
      "type": "array",
      "items": {
        "enum": [
          "generate:types",
          "generate:importmap"
        ],
        "type": "string"
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        }
      }
    },
    "requires": {
      "description": "Component-specific capabilities the consumer project must already provide.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectFiles"
      ],
      "properties": {
        "projectFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "paths",
              "anchors",
              "help"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "anchors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "help": {
                "type": "string",
                "minLength": 1
              },
              "collectionIdentifiers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                },
                "description": "Required direct identifiers in a statically readable buildConfig collections array."
              }
            }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patchedFiles"
      ],
      "properties": {
        "patchedFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sampleContent": {
      "type": "object"
    },
    "changelog": {
      "description": "Release notes for this component, newest first. Consumed by \"payload-components update\" so an upgrade states what changed, and so a change that invalidates stored Payload data cannot apply silently.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "summary"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "breaking": {
            "type": "boolean",
            "description": "Upgrading invalidates content already stored in Payload. \"update\" refuses the component unless --accept-breaking is passed."
          },
          "dataMigration": {
            "type": "string",
            "minLength": 1,
            "description": "What an operator must do to existing documents before adopting this version."
          }
        }
      },
      "minItems": 1
    },
    "installMode": {
      "type": "string",
      "enum": [
        "page-block",
        "file-only"
      ],
      "description": "File-only article template components have no Payload fragments or generators."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "installMode"
        ],
        "properties": {
          "installMode": {
            "const": "file-only"
          }
        }
      },
      "then": {
        "properties": {
          "payloadFragments": {
            "maxItems": 0
          },
          "postInstall": {
            "maxItems": 0
          },
          "recovery": {
            "properties": {
              "patchedFiles": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "payloadFragments": {
            "minItems": 1
          },
          "postInstall": {
            "minItems": 1
          },
          "recovery": {
            "properties": {
              "patchedFiles": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
